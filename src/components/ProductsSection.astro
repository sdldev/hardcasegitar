--- // Products strip - dark theme marquee
import { Image } from 'astro:assets';
import { products } from '../data/products';
---

<section class="section bg-secondary">
  <div class="container mb-8">
    <h2 class="text-heading-2 text-white mb-2">Produk Kami</h2>
    <a href="/products" class="inline-flex items-center gap-2 text-primary font-semibold underline-link hover:text-primary-light transition-colors">
      Lihat Semua Produk →
    </a>
  </div>

  <div class="overflow-hidden">
    <div class="flex animate-marquee whitespace-nowrap px-6 gap-6">
      {products.map(product => (
        <div class="w-[280px] flex-shrink-0">
          <a href={`/products/${product.slug}`} class="block group">
            <div class="aspect-square bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow duration-standard">
              <Image
                src={product.images[0]}
                alt={product.title}
                width={280}
                height={280}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-standard"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="mt-3">
              <span class="text-heading-5 font-bold text-white uppercase tracking-wide">{product.category}</span>
              <h3 class="text-heading-4 font-black text-white mt-1 leading-tight whitespace-normal">{product.title}</h3>
            </div>
          </a>
        </div>
      ))}
      {/* Duplicate for seamless loop */}
      {products.map(product => (
        <div class="w-[280px] flex-shrink-0" aria-hidden="true">
          <a href={`/products/${product.slug}`} class="block group" tabindex="-1">
            <div class="aspect-square bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow duration-standard">
              <Image
                src={product.images[0]}
                alt=""
                width={280}
                height={280}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-standard"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="mt-3">
              <span class="text-heading-4 font-bold text-white uppercase tracking-wide">{product.category}</span>
              <h3 class="text-heading-3 font-black text-white mt-1 leading-tight whitespace-normal">{product.title}</h3>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
