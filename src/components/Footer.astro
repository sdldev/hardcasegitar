--- // Footer section - company info, quick links, contact
import Icon from './Icons.astro';
import { PHONE_DISPLAY, PHONE_TEL, getWhatsAppUrl } from '../data/contact';

const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: 'Beranda', href: '/' },
  { label: 'Produk', href: '/products' },
  { label: 'Tentang Kami', href: '/about' },
  { label: 'FAQ', href: '/#faq' }
];

interface SocialLink {
  name: string;
  href: string;
  iconName: 'instagram' | 'facebook' | 'youtube';
}

const socialLinks: SocialLink[] = [
  { name: 'Instagram', href: '#', iconName: 'instagram' },
  { name: 'Facebook', href: '#', iconName: 'facebook' },
  { name: 'YouTube', href: '#', iconName: 'youtube' }
];
---

<footer class="bg-bg-primary border-t border-border-color">
  <div class="container px-4 py-16">
    <div class="grid md:grid-cols-3 gap-12">
      {/* Company Info */}
      <div>
        <div class="flex items-center gap-3 mb-4">
          <img src="/seo/logo.webp" alt="Logo" width={157} height={157} class="h-12 w-12 object-contain" loading="lazy" decoding="async" />
          <div>
            <h4 class="text-heading-5 font-bold text-white">Hardcase Guitar Indonesia</h4>
            <p class="text-body-sm text-text-muted mt-1">Custom Hardcase Maker</p>
          </div>
        </div>
        <p class="text-body-md text-text-muted leading-relaxed mb-4">
          Produsen custom hardcase gitar &amp; bass berkualitas tinggi. Perlindungan maksimal untuk instrumen kesayangan Anda.
        </p>

        {/* Social Media */}
        <div class="flex gap-3 mt-4">
          {socialLinks.map(link => (
            <a href={link.href} class="p-2 bg-white/5 rounded-full hover:bg-white/10 transition-colors" aria-label={link.name}>
              <Icon name={link.iconName}/>
            </a>
          ))}
        </div>
      </div>

      {/* Quick Links */}
      <div>
        <h5 class="text-heading-5 font-semibold text-white mb-4">Quick Links</h5>
        <ul class="space-y-3">
          {quickLinks.map(link => (
            <li>
              <a href={link.href} class="text-body-md text-text-muted hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Contact Info */}
      <div>
        <h5 class="text-heading-5 font-semibold text-white mb-4">Hubungi Kami</h5>
        <address class="not-italic space-y-3 text-body-md text-text-muted">
          <div class="flex items-start gap-3">
            <Icon name="location"/>
            <span>Jl. Semanan Pintu Air No.37<br/>Jakarta Barat 11750</span>
          </div>
          <div class="flex items-center gap-3">
            <Icon name="phone"/>
            <a href={`tel:${PHONE_TEL}`} class="hover:text-white transition-colors">{PHONE_DISPLAY}</a>
          </div>
          <div class="flex items-center gap-3">
            <Icon name="whatsapp"/>
            <a href={getWhatsAppUrl()} class="hover:text-whatsapp hover:text-primary-fg transition-colors">WhatsApp: {PHONE_DISPLAY}</a>
          </div>
        </address>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="mt-12 pt-8 border-t border-border-color flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-body-sm text-text-muted">
        © {currentYear} Hardcase Guitar Indonesia. All rights reserved.
      </p>
      <p class="text-body-sm text-text-muted">
        Designed by <a href="https://portalonline.id">portal online</a>
      </p>
    </div>
  </div>
</footer>
