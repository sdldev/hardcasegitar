export interface Props {
  name: keyof typeof iconPaths;
  size?: number;
  class?: string;
  viewBox?: string;
}

const { name, size = 24, class: className, viewBox = '0 0 24 24' } = Astro.props;

const icon = iconPaths[name];
if (!icon) {
  throw new Error(`Icon "${name}" not found`);
}
---

<svg
  viewBox={viewBox}
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  {...{
    fill: icon.fill,
    stroke: icon.stroke,
    'stroke-width': icon.strokeWidth,
    'stroke-linecap': icon.strokeLinecap,
    'stroke-linejoin': icon.strokeLinejoin
  }}
>
  <path d={icon.path} />
</svg>
