--- // Location section - embedded Google Map with address info and Icon helper

import Icon from './Icons.astro';
import { MAP_DIRECTIONS_URL, MAP_EMBED_URL, PHONE_DISPLAY, PHONE_TEL, getWhatsAppUrl } from '../data/contact';

interface Props {
  title?: string;
}

const {
  title = 'Lokasi Workshop',
} = Astro.props;
---

<section class="section bg-background">
  <div class="container">
    <h2 class="text-heading-2 text-center mb-8">{title}</h2>

    <div class="grid md:grid-cols-2 gap-12 items-start">
      {/* Address Info */}
      <div class="p-6 bg-bg-secondary border border-border-color rounded-xl hover:border-border-color-hover transition-colors duration-standard">
        <h3 class="text-heading-4 text-white mb-4">Alamat</h3>
        <address class="not-italic text-body-lg text-text-muted leading-relaxed space-y-3">
          <p class="font-semibold text-white">BENGKEL GITAR INDONESIA</p>
          <div class="flex items-start gap-2 text-white">
            <Icon name="location"/>
            <span>Jl. Semanan Pintu Air No.37, RT.7/RW.12,<br/>Duri Kosambi, Cengkareng<br/>Jakarta Barat 11750<br/>DKI Jakarta, Indonesia</span>
          </div>
          <div class="flex items-center gap-2 mt-2">
            <Icon name="phone"/>
            <a href={`tel:${PHONE_TEL}`} class="hover:text-primary transition-colors font-semibold">{PHONE_DISPLAY}</a>
          </div>
          <div class="flex flex-wrap gap-x-4 gap-y-2 mt-4">
            {/* WhatsApp */}
            <a href={getWhatsAppUrl()}
               class="inline-flex items-center gap-2 px-6 py-3 bg-whatsapp text-white font-semibold rounded-full hover:bg-whatsapp-hover transition-colors duration-standard">
              <Icon name="whatsapp"/>
              WhatsApp
            </a>
            {/* Rute */}
            <a href={MAP_DIRECTIONS_URL}
               target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 px-6 py-3 border border-border-color-light text-white font-semibold rounded-full hover:bg-white hover:text-bg-primary transition-colors duration-standard">
              <Icon name="navigate"/>
              Rute
            </a>
          </div>
        </address>
      </div>

      {/* Google Map Embed */}
      <div class="overflow-hidden rounded-xl shadow-lg">
        <iframe
          src={MAP_EMBED_URL}
          width="100%"
          height="400"
          style="border:0;"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          title="Bengkel Guitar Indonesia Location"
        ></iframe>
      </div>
    </div>
  </div>
</section>
