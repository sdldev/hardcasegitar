--- // About section - dark theme split layout
import { Image } from 'astro:assets';
import workshopImage from '../assets/images/Junaidi-Karo-Karo.webp';

interface Props {
  title?: string;
}

const { title = 'Instrumen Anda, Perlindungan Terbaik' } = Astro.props;
---

<section class="section bg-secondary">
  <div class="container grid md:grid-cols-2 gap-16 items-center">
    {/* Image */}
    <div class="relative">
      <Image
        src={workshopImage}
        alt="Custom hardcase gitar berkualitas tinggi"
        width={640}
        height={640}
        sizes="(max-width: 767px) 100vw, 50vw"
        class="w-full h-auto rounded-xl shadow-lg object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>

    {/* Content */}
    <div>
      <h2 class="text-heading-2 text-white mb-6">{title}</h2>
      <p class="text-body-lg text-text-muted leading-relaxed mb-6">
        Kami merancang dan membuat custom hardcase gitar &amp; bass yang menjaga instrumen Anda tetap aman — baik saat dibawa bepergian maupun ketika disimpan di rumah.
      </p>
    </div>
  </div>
</section>
