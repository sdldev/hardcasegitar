---
// Contact page — address + map (left), WhatsApp form (right).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icons.astro';
import {
  MAP_DIRECTIONS_URL,
  MAP_EMBED_URL,
  PHONE_DISPLAY,
  PHONE_TEL,
  WHATSAPP_NUMBER,
  getWhatsAppUrl,
} from '../data/contact';
---

<Base
  title="Kontak Kami - Hardcase Guitar Indonesia"
  description="Hubungi Hardcase Guitar Indonesia — workshop custom hardcase gitar & bass di Jakarta Barat. Kirim pesan langsung via WhatsApp."
>
  <main class="pt-[72px]">
    {/* Page hero */}
    <section class="bg-secondary py-16">
      <div class="container">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-px w-10 bg-primary"></span>
          <span class="text-body-sm font-semibold uppercase tracking-[0.2em] text-primary">Kontak</span>
        </div>
        <h1 class="text-heading-1 text-white mb-4">Hubungi Kami</h1>
        <p class="text-body-lg text-text-muted max-w-[600px]">
          Kunjungi workshop kami atau kirim pesan langsung — tim kami siap membantu kebutuhan hardcase Anda.
        </p>
      </div>
    </section>

    {/* Two columns: address + map | form */}
    <section class="section bg-background">
      <div class="container grid lg:grid-cols-2 gap-12 items-start">
        {/* Column 1: Address & Map */}
        <div>
          <div class="bg-secondary border border-border-color rounded-2xl p-8 mb-6">
            <h2 class="text-heading-3 text-white mb-6">Alamat Workshop</h2>
            <address class="not-italic space-y-4">
              <p class="text-body-lg font-semibold text-white">BENGKEL GITAR INDONESIA</p>
              <div class="flex items-start gap-3">
                <span class="flex-shrink-0 mt-0.5 text-primary"><Icon name="location" size={20} /></span>
                <span class="text-body-md text-text-muted leading-relaxed">
                  Jl. Semanan Pintu Air No.37, RT.7/RW.12,<br />
                  Duri Kosambi, Cengkareng<br />
                  Jakarta Barat 11750<br />
                  DKI Jakarta, Indonesia
                </span>
              </div>
              <div class="flex items-center gap-3">
                <span class="flex-shrink-0 text-primary"><Icon name="phone" size={20} /></span>
                <a href={`tel:${PHONE_TEL}`} class="text-body-md text-foreground hover:text-primary transition-colors font-semibold">
                  {PHONE_DISPLAY}
                </a>
              </div>
              <div class="flex items-center gap-3">
                <span class="flex-shrink-0 text-primary"><Icon name="whatsapp" size={20} /></span>
                <a href={getWhatsAppUrl()} target="_blank" rel="noopener noreferrer" class="text-body-md text-foreground hover:text-primary transition-colors font-semibold">
                  WhatsApp: {PHONE_DISPLAY}
                </a>
              </div>
            </address>

            <div class="flex flex-wrap gap-3 mt-8 pt-6 border-t border-border-color">
              <a
                href={getWhatsAppUrl()}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-3 bg-whatsapp text-white font-semibold rounded-full hover:bg-whatsapp-hover transition-colors duration-standard"
              >
                <Icon name="whatsapp" size={18} />
                WhatsApp
              </a>
              <a
                href={MAP_DIRECTIONS_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-3 border border-border-color text-foreground font-semibold rounded-full hover:bg-white/5 transition-colors duration-standard"
              >
                <Icon name="navigate" size={18} />
                Rute
              </a>
            </div>
          </div>

          {/* Map */}
          <div class="overflow-hidden rounded-2xl border border-border-color">
            <iframe
              src={MAP_EMBED_URL}
              width="100%"
              height="360"
              style="border:0;"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
              title="Lokasi Bengkel Guitar Indonesia"
            ></iframe>
          </div>
        </div>

        {/* Column 2: Form → WhatsApp */}
        <div class="bg-secondary border border-border-color rounded-2xl p-8">
          <h2 class="text-heading-3 text-white mb-2">Kirim Pesan</h2>
          <p class="text-body-md text-text-muted leading-relaxed mb-8">
            Isi nama dan pesan Anda — pesan akan dikirim langsung ke WhatsApp kami.
          </p>

          <form id="contact-form" class="space-y-5">
            <div>
              <label for="contact-name" class="block text-body-sm font-semibold text-foreground mb-2">Nama</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Nama Anda"
                class="contact-input"
              />
            </div>
            <div>
              <label for="contact-message" class="block text-body-sm font-semibold text-foreground mb-2">Pesan</label>
              <textarea
                id="contact-message"
                name="message"
                rows="6"
                required
                placeholder="Tulis pesan Anda, misalnya jenis instrumen dan kebutuhan hardcase..."
                class="contact-input resize-none"
              ></textarea>
            </div>
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 px-10 py-4 bg-orange-dark text-white text-button font-semibold rounded-full hover:bg-orange-dark-hover transition-colors duration-standard shadow-lg hover:shadow-xl"
            >
              Kirim via WhatsApp
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>
</Base>

<script client:load>
  import { WHATSAPP_NUMBER } from '../data/contact';

  const form = document.getElementById('contact-form');
  const nameInput = document.getElementById('contact-name');
  const messageInput = document.getElementById('contact-message');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const name = nameInput.value.trim();
    const message = messageInput.value.trim();
    if (!name || !message) return;

    const text = encodeURIComponent(`Halo, saya ${name}. ${message}`);
    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${text}`, '_blank', 'noopener,noreferrer');
  });
</script>

<style>
  .contact-input {
    width: 100%;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: 0.875rem 1rem;
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
    transition: border-color var(--duration-standard) var(--ease-standard);
  }
  .contact-input::placeholder {
    color: var(--text-muted);
    opacity: 0.6;
  }
  .contact-input:focus {
    outline: none;
    border-color: var(--primary);
  }
</style>
